# Public URL of the app (used in reminder links, calendar invites and webhooks)
APP_URL=http://localhost:3010

# Database: a local SQLite file by default. For production use Turso (libsql://…) + DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/sorriso.db
# DATABASE_AUTH_TOKEN=

# Phone numbers without +prefix are assumed to be from this country (Italy)
DEFAULT_COUNTRY_CODE=39

# ---- Email (any SMTP service). Without SMTP_URL, emails are captured in Dashboard → Messages.
# SMTP_URL=smtp://user:password@smtp.resend.com:587
# EMAIL_FROM="Sorriso <reminders@yourdomain.it>"

# ---- SMS & WhatsApp via Twilio. Without these, texts are captured in Dashboard → Messages.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+3902xxxxxxx                 # or use a Messaging Service:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxx   # approved WhatsApp template for business-initiated reminders

# ---- Reminder scheduling
# Protects GET /api/cron/reminders (required in production)
# CRON_SECRET=change-me
# Long-running servers send reminders in-process every minute; set to "off" to rely on the cron endpoint only.
# REMINDER_WORKER=off
