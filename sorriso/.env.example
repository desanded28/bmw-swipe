# Copy to .env.local for development. Everything is optional locally: without provider keys, messages are
# captured in Dashboard → Messages, and encryption and hashing fall back to built-in development keys.
#
# ---- Production checklist (patients' health data: GDPR Art. 9, 28 and 32) -------------------------------
# - EU regions everywhere: Vercel fra1 (vercel.json), Turso in an EU region, Twilio IE1 for SMS
#   (TWILIO_REGION/TWILIO_EDGE below), an SMTP provider sending from the EU (SMTP_PROVIDER_REGION).
# - A signed DPA with every provider (Vercel, Turso, Twilio, the SMTP provider; Meta for WhatsApp), listed in
#   src/lib/privacy/subprocessors.ts. US-owned providers are transfers even in an EU region (see docs/privacy/tia.md).
# - Link tracking and open tracking turned OFF in the SMTP provider's dashboard (no redirect links, no pixels).
# - DATA_ENCRYPTION_KEYS and HMAC_SECRET set and backed up outside the database: production refuses to start
#   without them, and losing them makes encrypted notes unreadable.
# - CRON_SECRET set, MESSAGING_LIVE=1 only on the live deployment, DEMO_MODE and ALLOW_DEMO_SEED unset.
# - PLATFORM_* filled in: they name Sorriso's controller in the patient notices.

# Public URL of the app (used in patient links, calendar invites and webhooks)
APP_URL=http://localhost:3010
# Brand name shown in the UI and as the default email sender name
# NEXT_PUBLIC_APP_NAME=Sorriso

# Database: a local SQLite file by default. For production use Turso (libsql://…, EU region) + DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/sorriso.db
# DATABASE_AUTH_TOKEN=

# Phone numbers without +prefix are assumed to be from this country (Italy)
DEFAULT_COUNTRY_CODE=39

# ---- Encryption and keyed hashes (required in production; development and tests use built-in keys)
# AES-256-GCM keys for health-related free text, "kid:base64-of-32-bytes", comma-separated. The FIRST key
# encrypts, all keys decrypt. Key ids: 1-16 of A-Z a-z 0-9 _ -. Generate a key with: openssl rand -base64 32
# Rotation: put a new key in front (k2:…,k1:…), deploy, run `npm run db:encrypt`, then drop the old key.
# DATA_ENCRYPTION_KEYS=k1:REPLACE_WITH_openssl_rand_base64_32
# Secret for keyed hashes (verified contacts, hashed IPs, one-time codes, unsubscribe links, the audit-log chain).
# Generate: openssl rand -hex 32. Changing it voids unsubscribe links already sent, verified contacts and the
# audit chain (verify it and record the chain heads first).
# HMAC_SECRET=
# Escape hatch for a local `next start` without keys (uses the development key). Never on a real deployment.
# SORRISO_ALLOW_DEV_KEY=1

# ---- Sorriso as controller (marketplace bookings, reviews, privacy center): shown in the patient notices
# PLATFORM_LEGAL_NAME="Your Company S.r.l."
# PLATFORM_ADDRESS="Via Esempio 1, 20100 Milano MI, Italia"
# PLATFORM_PRIVACY_EMAIL=privacy@example.com
# PLATFORM_DPO_EMAIL=dpo@example.com

# ---- Demo and safety fences
# 1 = demo deployment: demo login, reply simulator; messages go only to MESSAGING_ALLOWLIST.
# DEMO_MODE=1
# 1 = let the demo seed run against a non-file database or in production (it refuses otherwise).
# npm run db:reset sets it for its own seed run.
# ALLOW_DEMO_SEED=1
# Outside the live deployment, real messages go only to these recipients (comma-separated E.164 numbers and emails).
# Everything else is captured in Dashboard → Messages. Empty = nobody.
# MESSAGING_ALLOWLIST=+393331234567,dev@example.com
# 1 = this is the live deployment: message any patient. Honoured only with NODE_ENV=production, outside demo
# mode and, on Vercel, only when VERCEL_ENV=production (previews never message real patients).
# MESSAGING_LIVE=1

# ---- Email (any SMTP service). Without SMTP_URL, emails are captured in Dashboard → Messages.
# SMTP_URL=smtp://user:password@smtp.example.eu:587
# EMAIL_FROM="Sorriso <reminders@yourdomain.it>"
# Refuse to send without STARTTLS (TLS 1.2 or later). On by default; 0 only for a local test server.
# SMTP_REQUIRE_TLS=1
# The SMTP provider as a sub-processor (/legal/subprocessors, DPA annex). NAME, ENTITY and REGION are required
# in production when SMTP_URL is set: the server refuses to start without them.
# SMTP_PROVIDER_NAME=Mailer
# SMTP_PROVIDER_ENTITY="Mailer GmbH"
# SMTP_PROVIDER_REGION="EU — Germany"
# Ultimate parent outside the EEA, if any (e.g. "Mailer Inc. (US)")
# SMTP_PROVIDER_PARENT=
# Public DPA URL (leave empty when the signed copy is available on request only)
# SMTP_PROVIDER_DPA_URL=
# Transfer tool: eu | dpf | scc | dpf+scc (default dpf+scc; "eu" only for an EU-owned provider)
# SMTP_PROVIDER_TRANSFER=dpf+scc

# ---- SMS & WhatsApp via Twilio. Without these, texts are captured in Dashboard → Messages.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx               # also validates the inbound and status webhooks
# TWILIO_FROM=+3902xxxxxxx                 # or use a Messaging Service:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# SMS through Twilio's EU data residency region (requests go to https://api.dublin.ie1.twilio.com)
# TWILIO_REGION=ie1
# TWILIO_EDGE=dublin
# Credentials are per region: the Account SID is shared, but API keys and auth tokens created in IE1 work only
# there, and WhatsApp stays on the default US1 region. Region-specific credentials (read once WP3 lands; each
# webhook is validated with the auth token of the region that sent it):
# TWILIO_IE1_API_KEY_SID=SKxxxxxxxx
# TWILIO_IE1_API_KEY_SECRET=xxxxxxxx
# TWILIO_IE1_AUTH_TOKEN=xxxxxxxx
# TWILIO_US1_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886
# Meta-approved WhatsApp templates as JSON, message kind -> locale -> Content SID. A kind/locale without a
# template falls back to SMS or email, so a patient never gets a message in the wrong language.
# TWILIO_WHATSAPP_CONTENT_SIDS={"reminder":{"it":"HXxxxxxxxx","en":"HXxxxxxxxx"}}
# Single-template setting read until the per-locale map above is in place
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxx

# ---- Background jobs
# Protects /api/cron/reminders and /api/cron/retention (required in production; Vercel Cron sends it automatically)
# CRON_SECRET=change-me
# Long-running servers run reminders (every minute), care jobs (every 15 minutes), retention (daily) and log the
# audit chain heads (daily) in-process; set to "off" to rely on the cron endpoints only. Always off on Vercel.
# REMINDER_WORKER=off
